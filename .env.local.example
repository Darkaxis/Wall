# Supabase Configuration for Wall (Y2K Gen-X Soft Club Edition)
# Copy this file to .env.local and add your Supabase project URL and Anon Key.
# Run the SQL inside supabase/schema.sql in your Supabase SQL Editor to create the `posts` table and `wall-media` storage bucket.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
